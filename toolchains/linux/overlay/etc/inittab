# Opcode Linux (busybox init). The browser terminal is the virtio console
# (hvc0); the serial port (ttyS0) gets a login prompt too.
::sysinit:/usr/local/sbin/opcode-boot
hvc0::respawn:/sbin/getty -L -n -l /usr/local/sbin/opcode-login 0 hvc0 xterm-256color
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/sync

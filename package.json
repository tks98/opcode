{
  "name": "opcode",
  "private": true,
  "version": "0.0.1",
  "description": "A browser IDE with a real terminal: write and run Python, JavaScript, TypeScript, Java, C#, C, C++, Rust, Go and more, or learn Linux and Docker, entirely in the browser.",
  "license": "AGPL-3.0-or-later",
  "repository": "github:tks98/opcode",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/fetch-rust.mjs && node scripts/fetch-java.mjs && node scripts/fetch-csharp.mjs && node scripts/copy-npm-toolchains.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-rust.mjs && node scripts/fetch-java.mjs && node scripts/fetch-csharp.mjs && node scripts/copy-npm-toolchains.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/server.mjs",
    "preview-host": "node scripts/preview-host.mjs --serve 5174",
    "relay": "node scripts/wisp-server.mjs",
    "check": "svelte-check --threshold warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:go": "toolchains/go/build.sh",
    "build:stty": "node toolchains/stty/build.mjs",
    "build:opcode-wait": "node toolchains/opcode-wait/build.mjs",
    "build:sqlite": "node toolchains/sqlite/build.mjs",
    "build:lua": "node toolchains/lua/build.mjs",
    "build:csharp-runner": "toolchains/csharp/build-runner.sh",
    "build:linux": "sudo toolchains/linux/build.sh && node toolchains/linux/make-state.mjs",
    "build:docker": "sudo toolchains/linux/build.sh docker && node toolchains/linux/make-state.mjs docker",
    "build:preview-host": "node scripts/preview-host.mjs",
    "fetch:rust": "node scripts/fetch-rust.mjs --force",
    "fetch:java": "node scripts/fetch-java.mjs --force",
    "build:ristretto": "toolchains/java/build-ristretto.sh"
  },
  "devDependencies": {
    "@antonz/ruby-wasi": "3.2.2",
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "24.19.1",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "webr": "0.6.0",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@wasmer/sdk": "^0.19.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@yowasp/clang": "22.0.0-git20542-10",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.57.0",
    "v86": "0.5.470"
  }
}
